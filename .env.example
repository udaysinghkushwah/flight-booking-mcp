# Server host and port
MCP_HOST=0.0.0.0
MCP_PORT=8080

# Allowed host headers (comma-separated). Set to * to allow all hosts or your public domain:
MCP_ALLOWED_HOSTS=my-62557ba230744e00bfa6dee1bce8609e.ecs.us-east-1.on.aws,my-62557ba230744e00bfa6dee1bce8609e.ecs.us-east-1.on.aws:*,0.0.0.0,0.0.0.0:*,localhost,localhost:*

# Optional browser origins (comma-separated):
MCP_ALLOWED_ORIGINS=https://app.example.com

# Disable DNS rebinding protection (true if behind private ALB/Gateway):
MCP_DISABLE_DNS_REBINDING=false

# Enable/disable API key authentication:
MCP_AUTH_ENABLED=true

# Persistent SQLite Database path:
DB_PATH=/app/flight_booking.db

# Rate limiter settings:
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_PER_SEC=1.0

# Pre-configured Production API Keys:
# - Agent Key: flight-agent-key-secret (scopes: flight:read, flight:book)
# - Admin Key: flight-admin-key-secret (scopes: flight:read, flight:book, flight:admin, sql:readonly)
# - Viewer Key: flight-viewer-key-secret (scopes: flight:read)
